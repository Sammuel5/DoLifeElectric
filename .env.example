# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  DLE Entertainment — Environment Variables                              ║
# ║  Copy this file to .env.local and fill in the values.                  ║
# ║                                                                         ║
# ║  ⚠  IMPORTANT — DATABASE NAME MUST BE "DoLifeElectric" (exactly)       ║
# ║     After the last "/" in MONGODB_URI, before the "?", the text must   ║
# ║     read DoLifeElectric (capital D, L, E). If it says "test", "admin", ║
# ║     "dle-entertainment", or anything else, your data will be in a      ║
# ║     DIFFERENT database and won't show up on other computers.           ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# MongoDB (local or MongoDB Atlas)
# The database name after the "/" must be "DoLifeElectric" — see warning above.
#
# OPTION 1 — Standard SRV connection string (works on most computers/networks):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/DoLifeElectric?retryWrites=true&w=majority&appName=DoLifeElectric
#
# OPTION 2 — NON-SRV connection string (use THIS if you get "querySrv ECONNREFUSED" errors
# or "Server selection timed out" on Windows with DoH / VPN / strict antivirus).
# Note the "/DoLifeElectric?" part — that's what selects the database.
MONGODB_URI=mongodb://<username>:<password>@ac-zma64rm-shard-00-00.yflcgd9.mongodb.net:27017,ac-zma64rm-shard-00-01.yflcgd9.mongodb.net:27017,ac-zma64rm-shard-00-02.yflcgd9.mongodb.net:27017/DoLifeElectric?replicaSet=atlas-zma64rm-shard-0&ssl=true&authSource=admin&retryWrites=true&w=majority&appName=DoLifeElectric

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=generate-with-node-e-"console.log(crypto.randomBytes(32).toString('base64'))"

# Google OAuth (from Google Cloud Console — https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==============================================
# PAYMONGO (Philippine Payments)
# ==============================================
# Get these from https://dashboard.paymongo.com/developers
# Test keys start with sk_test_ / pk_test_
# Live keys start with sk_live_ / pk_live_
#
# ⚠  PAYMONGO_SECRET_KEY (starts sk_...) is a SERVER-ONLY secret.
#     NEVER put it in NEXT_PUBLIC_... or commit it to GitHub.
#     It is used only inside /app/api/* routes (server-side).
PAYMONGO_SECRET_KEY=sk_test_your_paymongo_secret_key
PAYMONGO_PUBLIC_KEY=pk_test_your_paymongo_public_key
# Webhook secret — register in PayMongo Dashboard → Developers → Webhooks:
#   URL: https://YOUR-DOMAIN/api/webhooks/paymongo
#   Events: payment.paid, payment.failed, payment.refunded, link.payment.paid
# The returned secret starts with whsk_
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret

# === ADMIN / OWNER SETTINGS ===
# OWNER_EMAIL is the SUPER ADMIN (you!). This email automatically gets full access
# on first sign-in. Only this email can add/remove other admins, edit gift statuses,
# upload music, and bulk-delete activity.
OWNER_EMAIL=ssammuelbarrientos@gmail.com

# ADMIN_EMAILS is a LEGACY comma-separated list (can leave blank)
ADMIN_EMAILS=

# Company Bank Account Information (for reference)
COMPANY_BANK_NAME=Your Bank / PayMongo Wallet
COMPANY_BANK_ACCOUNT=XXXXXXXXXXXXXXX
COMPANY_BANK_ROUTING=XXXXXXXXX
COMPANY_ACCOUNT_HOLDER=DLE Entertainment Inc.

# ==============================================
# CONTACT FORM EMAIL (pick ONE provider below)
# ==============================================
# Where contact-form submissions are delivered:
CONTACT_EMAIL=info@dle-entertainment.com

# --- OPTION A (RECOMMENDED): Resend ---
# Free, 3,000 emails/month. Sign up at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev

# --- OPTION B: Gmail / SMTP (requires Gmail App Password) ---
# Regular Gmail passwords will be rejected — you need an App Password:
#   1) Enable 2-Step Verification on the Gmail account
#   2) Google Account → Security → App passwords → create one (16 chars)
#   3) Use that 16-char password below
# EMAIL_SERVER_HOST=smtp.gmail.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=your-email@dle-entertainment.com
# EMAIL_SERVER_PASSWORD=your-16-char-gmail-app-password
# EMAIL_FROM=noreply@dle-entertainment.com
