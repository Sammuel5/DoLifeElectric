# ═══════════════════════════════════════════════════════════════════════════
# DLE Entertainment — .gitignore
# Files/folders listed here will NEVER be committed to GitHub.
# ═══════════════════════════════════════════════════════════════════════════

# ── Dependencies ──────────────────────────────────────────────────────────
node_modules/
jspm_packages/

# ── Next.js / Build output ───────────────────────────────────────────────
.next/
out/
build/
dist/

# ── 🔒 SECRETS / ENVIRONMENT VARIABLES ────────────────────────────────────
# THESE FILES CONTAIN API KEYS, DATABASE PASSWORDS, AND SECRETS.
# NEVER commit them. Use .env.example as the public template.
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ── Logs ──────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── Uploaded user content (large files + user data) ──────────────────────
#public/uploads/*
#uploads/
#!public/uploads/.gitkeep

# ── Vercel / deployment ──────────────────────────────────────────────────
.vercel

# ── Testing / coverage ───────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Cache directories ────────────────────────────────────────────────────
.cache/
.eslintcache
.turbo/
*.tgz

# ── IDE / editor ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Backup / temp files ──────────────────────────────────────────────────
*.bak
*.tmp
*.old
*.orig

# ── OS junk ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
tmp/
temp/

# ── Python (for any diagnostic scripts) ─────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Credential / key files (extra safety) ────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_*
id_rsa*
id_ed25519*
.ssh/
.npmrc
.yarnrc
.netrc
credentials.json
service-account*.json
*credentials*.json
*secret*.json
